{% from "sections.html.j2" import render_section %}
{% set layout = 'position_first' %}
{% set skills_style = 'lines' %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ contact.full_name }} - Resume</title>
  <style>{{ css }}</style>
</head>
<body class="tpl-modern">
  <header class="resume-header">
    <h1>{{ contact.full_name }}</h1>
    {% if contact.address_line %}<p class="address-line">{{ contact.address_line }}</p>{% endif %}
    {% if contact.contact_line %}<p class="contact-line">{{ contact.contact_line }}</p>{% endif %}
    {% if contact.links %}
    <p class="contact-links">{% for link in contact.links %}{% if not loop.first %} | {% endif %}<a href="{{ link.href }}">{{ link.label }}: {{ link.text }}</a>{% endfor %}</p>
    {% endif %}
    {% if contact.job_title %}<p class="job-title">{{ contact.job_title }}</p>{% endif %}
  </header>
  <main>
    {% for section in sections %}{{ render_section(section, layout, skills_style) }}{% endfor %}
  </main>
</body>
</html>
