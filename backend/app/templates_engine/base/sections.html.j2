{% macro entry_head(layout, primary, secondary, meta, dates) -%}
<div class="entry-head">
  {% if primary or dates %}
  <div class="line1">{% if primary %}<span class="entry-primary">{{ primary }}</span>{% endif %}{% if dates %}<span class="entry-dates">{{ dates }}</span>{% endif %}</div>
  {% endif %}
  {% if layout != 'inline' and (secondary or meta) %}
  <div class="line2">{% if secondary %}<span class="entry-secondary">{{ secondary }}</span>{% endif %}{% if meta %}<span class="entry-meta">{{ meta }}</span>{% endif %}</div>
  {% endif %}
</div>
{%- endmacro %}

{% macro render_experience(items, layout) -%}
{% for item in items %}
<div class="entry">
  {% if layout == 'company_first' %}
    {{ entry_head(layout, item.company, item.position, item.location, item.dates) }}
  {% elif layout == 'inline' %}
    {% set primary = [item.position, item.company, item.location] | reject('equalto', '') | join(', ') %}
    {{ entry_head(layout, primary, '', '', item.dates) }}
  {% else %}
    {{ entry_head(layout, item.position, item.company, item.location, item.dates) }}
  {% endif %}
  {% if item.summary %}<p class="entry-summary">{{ item.summary }}</p>{% endif %}
  {% if item.bullets %}<ul>{% for bullet in item.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
</div>
{% endfor %}
{%- endmacro %}

{% macro render_education(items, layout) -%}
{% for item in items %}
<div class="entry">
  {% set meta = [item.location, item.gpa_text] | reject('equalto', '') | join(' | ') %}
  {% if layout == 'company_first' %}
    {{ entry_head(layout, item.institution, item.degree_line, meta, item.dates) }}
  {% elif layout == 'inline' %}
    {% set primary = [item.degree_line, item.institution, item.gpa_text] | reject('equalto', '') | join(', ') %}
    {{ entry_head(layout, primary, '', '', item.dates) }}
  {% else %}
    {{ entry_head(layout, item.degree_line, item.institution, meta, item.dates) }}
  {% endif %}
  {% if item.details %}<ul>{% for detail in item.details %}<li>{{ detail }}</li>{% endfor %}</ul>{% endif %}
</div>
{% endfor %}
{%- endmacro %}

{% macro render_skills(items, skills_style) -%}
{% if skills_style == 'inline' %}
<p class="skills-inline">{% for item in items %}{% if not loop.first %} | {% endif %}{% if item.group %}<strong>{{ item.group }}:</strong> {% endif %}{{ item.text }}{% endfor %}</p>
{% else %}
{% for item in items %}
<p class="skills-line">{% if item.group %}<strong>{{ item.group }}:</strong> {% endif %}{{ item.text }}</p>
{% endfor %}
{% endif %}
{%- endmacro %}

{% macro render_projects(items, layout) -%}
{% for item in items %}
<div class="entry">
  {% if layout == 'inline' %}
    <div class="entry-head">
      <div class="line1"><span class="entry-primary">{% if item.name %}<strong>{{ item.name }}</strong>{% endif %}{% if item.tech_stack %}{% if item.name %} - {% endif %}{{ item.tech_stack }}{% endif %}{% if item.links %}{% if item.name or item.tech_stack %} | {% endif %}{% for link in item.links %}{% if not loop.first %} | {% endif %}<a href="{{ link.href }}">{{ link.label }}</a>{% endfor %}{% endif %}</span>{% if item.dates %}<span class="entry-dates">{{ item.dates }}</span>{% endif %}</div>
    </div>
    {% if item.description and item.description | length <= 90 %}<p class="project-description">{{ item.description }}</p>{% endif %}
  {% else %}
    {{ entry_head(layout, item.name, '', '', item.dates) }}
    {% if item.description %}<p class="project-description">{{ item.description }}</p>{% endif %}
    {% if item.tech_stack %}<p class="project-tech-stack"><em>{{ item.tech_stack }}</em></p>{% endif %}
    {% if item.links %}<p class="project-links">{% for link in item.links %}{% if not loop.first %} | {% endif %}<a href="{{ link.href }}">{{ link.label }}</a>{% endfor %}</p>{% endif %}
  {% endif %}
  {% if item.bullets %}<ul>{% for bullet in item.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
</div>
{% endfor %}
{%- endmacro %}

{% macro render_simple_list(section, layout) -%}
{% for item in section['items'] %}
<div class="entry">
  {% if section.id == 'certifications' %}
    {{ entry_head(layout, item.name, item.issuer, item.date_text, '') }}
    {% if item.link %}<p class="entry-link"><a href="{{ item.link.href }}">{{ item.link.text }}</a></p>{% endif %}
  {% elif section.id == 'achievements' %}
    {{ entry_head(layout, item.title, item.description, '', item.date) }}
  {% elif section.id == 'languages' %}
    {{ entry_head(layout, item.language, item.proficiency, '', '') }}
  {% elif section.id == 'publications' %}
    {{ entry_head(layout, item.title, item.publisher, '', item.date) }}
    {% if item.link %}<p class="entry-link"><a href="{{ item.link.href }}">{{ item.link.text }}</a></p>{% endif %}
  {% elif section.id == 'volunteer' %}
    {% if layout == 'company_first' %}
      {{ entry_head(layout, item.organization, item.role, '', item.dates) }}
    {% elif layout == 'inline' %}
      {% set primary = [item.role, item.organization] | reject('equalto', '') | join(', ') %}
      {{ entry_head(layout, primary, '', '', item.dates) }}
    {% else %}
      {{ entry_head(layout, item.role, item.organization, '', item.dates) }}
    {% endif %}
    {% if item.bullets %}<ul>{% for bullet in item.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
  {% elif section.id == 'references' %}
    {{ entry_head(layout, item.name, item.line, '', '') }}
    {% set contact = [item.email, item.phone] | reject('equalto', '') | join(' | ') %}
    {% if contact %}<p class="reference-contact">{{ contact }}</p>{% endif %}
  {% endif %}
</div>
{% endfor %}
{%- endmacro %}

{% macro render_text(section) -%}
{% if section.text %}<p class="section-text">{{ section.text }}</p>{% endif %}
{%- endmacro %}

{% macro render_section(section, layout, skills_style) -%}
<section class="resume-section section-{{ section.id }}">
  <h2 class="section-title">{{ section.label }}</h2>
  {% if section.id == 'summary' or section.id == 'interests' %}
    {{ render_text(section) }}
  {% elif section.id == 'experience' %}
    {{ render_experience(section['items'], layout) }}
  {% elif section.id == 'education' %}
    {{ render_education(section['items'], layout) }}
  {% elif section.id == 'skills' %}
    {{ render_skills(section['items'], skills_style) }}
  {% elif section.id == 'projects' %}
    {{ render_projects(section['items'], layout) }}
  {% else %}
    {{ render_simple_list(section, layout) }}
  {% endif %}
</section>
{%- endmacro %}
