{% macro entry_head(layout, primary, secondary, meta, dates) -%}
<div class="entry-head">
  {% if primary or dates %}
  <div class="line1">{% if primary %}<span class="entry-primary">{{ primary }}</span>{% endif %}{% if dates %}<span class="entry-dates">{{ dates }}</span>{% endif %}</div>
  {% endif %}
  {% if layout != 'inline' and (secondary or meta) %}
  <div class="line2">{% if secondary %}<span class="entry-secondary">{{ secondary }}</span>{% endif %}{% if meta %}<span class="entry-meta">{{ meta }}</span>{% endif %}</div>
  {% endif %}
</div>
{%- endmacro %}

{% macro render_experience(items, layout) -%}
{% for item in items %}
<div class="entry">
  {% if layout == 'company_first' %}
    {{ entry_head(layout, item.company, item.position, item.location, item.dates) }}
  {% elif layout == 'inline' %}
    {% set primary = [item.position, item.company, item.location] | reject('equalto', '') | join(', ') %}
    {{ entry_head(layout, primary, '', '', item.dates) }}
  {% else %}
    {{ entry_head(layout, item.position, item.company, item.location, item.dates) }}
  {% endif %}
  {% if item.summary %}<p class="entry-summary">{{ item.summary }}</p>{% endif %}
  {% if item.bullets %}<ul>{% for bullet in item.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
</div>
{% endfor %}
{%- endmacro %}

{% macro render_education(items, layout) -%}
{% for item in items %}
<div class="entry">
  {% set meta = [item.location, item.gpa_text] | reject('equalto', '') | join(' | ') %}
  {% if layout == 'company_first' %}
    {{ entry_head(layout, item.institution, item.degree_line, meta, item.dates) }}
  {% elif layout == 'inline' %}
    {% set primary = [item.degree_line, item.institution, item.gpa_text] | reject('equalto', '') | join(', ') %}
    {{ entry_head(layout, primary, '', '', item.dates) }}
  {% else %}
    {{ entry_head(layout, item.degree_line, item.institution, meta, item.dates) }}
  {% endif %}
  {% if item.details %}<ul>{% for detail in item.details %}<li>{{ detail }}</li>{% endfor %}</ul>{% endif %}
</div>
{% endfor %}
{%- endmacro %}

{% macro render_skills(items, skills_style) -%}
{% if skills_style == 'inline' %}
<p class="skills-inline">{% for item in items %}{% if not loop.first %} | {% endif %}{% if item.group %}<strong>{{ item.group }}:</strong> {% endif %}{{ item.text }}{% endfor %}</p>
{% else %}
{% for item in items %}
<p class="skills-line">{% if item.group %}<strong>{{ item.group }}:</strong> {% endif %}{{ item.text }}</p>
{% endfor %}
{% endif %}
{%- endmacro %}

{% macro render_projects(items, layout) -%}
{% for item in items %}
<div class="entry">
  {% if layout == 'inline' %}
    {% set primary = [item.name, item.tech_stack] | reject('equalto', '') | join(' - ') %}
    {{ entry_head(layout, primary, '', '', item.dates) }}
    {% if item.links %}<p class="project-links">{% for link in item.links %}{% if not loop.first %} | {% endif %}<a href="{{ link.href }}">{{ link.text }}</a>{% endfor %}</p>{% endif %}
    {% if item.description and item.description | length <= 90 %}<p class="project-description">{{ item.description }}</p>{% endif %}
  {% else %}
    {{ entry_head(layout, item.name, '', '', item.dates) }}
    {% if item.description %}<p class="project-description">{{ item.description }}</p>{% endif %}
    {% if item.tech_stack %}<p class="project-tech-stack"><em>{{ item.tech_stack }}</em></p>{% endif %}
    {% if item.links %}<p class="project-links">{% for link in item.links %}{% if not loop.first %} | {% endif %}<a href="{{ link.href }}">{{ link.text }}</a>{% endfor %}</p>{% endif %}
  {% endif %}
  {% if item.bullets %}<ul>{% for bullet in item.bullets %}<li>{{ bullet }}</li>{% endfor %}</ul>{% endif %}
</div>
{% endfor %}
{%- endmacro %}
