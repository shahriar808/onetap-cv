ALLOWED_ORIGINS=http://localhost:5173
MAX_BODY_BYTES=1048576
# Leave SMTP_USER and SMTP_PASSWORD blank only for a localhost debug SMTP server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FEEDBACK_TO_EMAIL=
# Defaults to SMTP_USER when empty.
FEEDBACK_FROM_EMAIL=
FEEDBACK_RATE_LIMIT=3/hour
# Trust forwarded client IP headers only from your reverse proxy addresses.
FORWARDED_ALLOW_IPS=127.0.0.1
